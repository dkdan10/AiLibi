[importlinter]
# Every top-level package that ships or gates shipping. grimp builds nodes only
# for these, and a traversal stops at the first hop into a package it does not
# know — so a root left out here is a hole in the transitive claim below, not a
# package the contracts merely ignore. `tests/` and `experiments/` stay out by
# design (both import the inner packages freely); the agents/ source scan in
# tests/test_firewall.py is the second layer that covers them.
root_packages =
    agents
    engine
    llm
    meetings
    observation
    training
    orchestrator
    api
    eval
    scripts

[importlinter:agents_must_not_import_engine]
name = Agents must not import engine
type = forbidden
source_modules =
    agents
forbidden_modules =
    engine

[importlinter:agents_must_not_import_training]
name = Agents must not import training
type = forbidden
source_modules =
    agents
forbidden_modules =
    training

[importlinter:agents_must_not_import_meetings_manager]
name = Agents must not import meetings.manager
type = forbidden
source_modules =
    agents
forbidden_modules =
    meetings.manager

[importlinter:observation_must_not_import_agents_meetings_llm]
name = Observation must not import agents, meetings, or llm
type = forbidden
source_modules =
    observation
forbidden_modules =
    agents
    meetings
    llm
