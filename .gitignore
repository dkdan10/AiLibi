.DS_Store
.venv/
.pytest_cache/
.ruff_cache/
.import_linter_cache/
__pycache__/
*.py[cod]
.claude/

# Local environment files
.env
.env.local
.env.*.local

# Node / frontend (frontend/.gitignore covers dist/, .vite/, coverage/)
node_modules/

# Replays: user-generated replay JSONL files in the top-level replays/ dir
# are local artifacts; the curated samples under replays/samples/ are the
# only replays committed to the repo (see task 4.12 / DESIGN.md §7).
replays/*.jsonl
!replays/samples/
replays/tournament-eval-report.json
# Internal leak-test packet logs from the observation firewall — never commit.
**/*.audit.jsonl

# Transient per-refresh staging dir (scripts/refresh_samples.sh): the atomic
# stage + parallel-worker queue/state live here and are removed by the script's
# EXIT trap. A Featherless re-record now runs for hours with 2 workers (Task
# 14.12), so this dir lingers long enough to surface as untracked — ignore it so
# it is never accidentally committed with the re-recorded samples.
replays/samples/.ailibi-refresh-stage-*/

# Design-thread local working docs (not committed; the canonical plan lives in tasks/ + memory)
*.local.md
