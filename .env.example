# AiLibi environment template. Copy it to .env (gitignored) and fill in values;
# never commit a real .env or API key. Checks and CI need none of these: the test
# suite clears them and pins the deterministic fake provider. Provider defaults,
# model ids and the real-provider test gates are in llm/README.md.

# -----------------------------------------------------------------------------
# LLM provider selection
# -----------------------------------------------------------------------------
# fake (offline; the default for games, the API and checks), anthropic, ollama
# (local) or featherless. The two recorder scripts default to a real provider.
AILIBI_LLM_PROVIDER=fake

# Prompt family; unset serves the frozen qwen3_5_9b reference set. The samples
# were recorded with qwen3_6_27b: export it for a sample-compatible run, and for
# the 9-player set pass its replays/samples/9p2i/experiment-config.json to
# run_tournament.py --experiment-config.
# AILIBI_PROMPT_SET=qwen3_6_27b

# Model id for meeting turns; unset uses the provider's default.
# AILIBI_LLM_MEETING_MODEL=qwen3.5:9b
# Model id for triggered checks; unset uses the provider's default.
# AILIBI_LLM_TRIGGER_MODEL=qwen3.5:9b

# Required when the provider is anthropic.
ANTHROPIC_API_KEY=

# Ollama server address.
# AILIBI_OLLAMA_HOST=localhost:11434
# Ollama per-game generation seed; recorded replays, not seeds, are exact.
# AILIBI_OLLAMA_SEED=0
# Ollama context window, prompt plus output. 8192 suits the default 9B family;
# qwen3_6_27b prompts at nine players reach about 11,900 tokens, so raise it
# (16384, say) for those runs.
# AILIBI_OLLAMA_NUM_CTX=8192

# Required when the provider is featherless.
FEATHERLESS_API_KEY=
# Featherless OpenAI-compatible base URL, for a proxy or self-hosted endpoint.
# AILIBI_FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# Per-game spending cap in USD on a paid provider (default 1.00). Featherless and
# Ollama record $0, so there the per-turn and per-vote token caps are the limit.
# AILIBI_MAX_COST_USD=1.00

# -----------------------------------------------------------------------------
# Belief-substrate levers
# -----------------------------------------------------------------------------
# GRADUATED LEVERS — always ON, nothing to set. Each was adopted at a baseline
# record and its env gate deleted; its key stays in every recording's substrate
# stamp (orchestrator/replay.py, _RETIRED_ALWAYS_ON_LEVERS):
#   testimony_as_content, witnessed_kill_evidence, movement_perception,
#   unfreeze_memory, evidence_quality_lift, reporter_exculpation,
#   hard_evidence_gate, observation_id_rendering, citation_gate, absence_prior,
#   roll_call_round, whereabouts_interior_flags, vent_placement_contradictions,
#   task_completion_from_events, self_location_trail, movement_claim_shape,
#   grounded_prosecution, map_aware_arbitration, structured_turn_markers,
#   meeting_outcome_memory, coalesced_memory_render
#   (citation_gate is a stamp key only: its mechanism was retired, and
#   meetings.manager.label_ballot_grounding labels such a ballot instead)

# The live levers are OFF unless set to 1, true, yes or on. Recordings stamp
# them, so keep them OFF to serve or verify the committed sample sets.

# The impostor-answer template arm: impostors answer the whereabouts roll call.
# AILIBI_IMPOSTOR_ROLL_CALL=0
# Reporter voice: turn prompts name the reporter and call reporting weak evidence
# of innocence.
# AILIBI_REPORTER_REASONING=0
# Source counts: the ballot shows how many voices carry a charge, how many saw.
# AILIBI_CORROBORATION_DISCIPLINE=0
# Testimony shapes: listeners keep spoken placements, transitions and kills.
# AILIBI_TESTIMONY_SHAPES=0
# Source-time observations: events reach memory at their own tick; 2 is v2.
# AILIBI_TEMPORAL_OBSERVATIONS=0

# -----------------------------------------------------------------------------
# Independently versioned experiments
# -----------------------------------------------------------------------------
# Meeting experiments: unset, 0, false, no or off is OFF; 1, true, yes or on is
# ON (2 selects v2 where noted); anything else raises. A game records the version
# it ran.

# Evidence context and memory; 2 is v2, needing AILIBI_TEMPORAL_OBSERVATIONS=2.
# AILIBI_EVIDENCE_REASONING=0
# Bounded rebuttal: at most one extra reply, from a player just accused.
# AILIBI_BOUNDED_REBUTTAL=0
# Public accounts; needs prompt family qwen3_6_27b and temporal observations 2.
# AILIBI_PUBLIC_ACCOUNTS=0
# Attributed testimony; needs prompt family qwen3_6_27b.
# AILIBI_ATTRIBUTED_TESTIMONY=0

# -----------------------------------------------------------------------------
# API server (spectator API)
# -----------------------------------------------------------------------------
# Host port docker-compose.yml publishes on loopback; the app never reads it.
AILIBI_API_PORT=8000

# Parent folder of the replay sets to serve; unset tries replays/ then samples.
# AILIBI_REPLAY_DIR=./replays/samples

# Exact cross-origin allowlist, comma-separated; unset allows none, never "*".
# AILIBI_CORS_ORIGINS=https://spectator.example.com
