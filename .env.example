# AiLibi — environment configuration template
#
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# .env is gitignored. NEVER commit your real .env or the actual API key.
# The CI pipeline + scripts/check.sh do NOT need any of these set —
# defaults route to the deterministic fake provider.

# -----------------------------------------------------------------------------
# LLM provider selection
# -----------------------------------------------------------------------------
# "fake"       — deterministic in-process stub (CI default; no network)
# "anthropic"  — real Anthropic provider (requires ANTHROPIC_API_KEY)
# "ollama"     — local Ollama open model (the Phase-7 eval pivot's canonical
#                provider, superseded by Featherless at Phase 14; free, served
#                from your own machine — see the "Providers" part of README
#                "Run a tournament & read the metrics"). CI never selects or
#                reaches it.
# "featherless"— hosted Featherless AI, OpenAI-compatible (THE canonical eval
#                provider since Phase 14; flat-rate subscription recorded as
#                $0 — requires FEATHERLESS_API_KEY). CI never selects or
#                reaches it.
#
# Required only when running a real-provider eval
# (see audits/prompts/pre-phase-4-real-provider-eval-prompt.md) or doing
# local smoke tests against a real LLM. The CI pipeline + scripts/check.sh
# leave this unset and route to "fake".
AILIBI_LLM_PROVIDER=fake

# Prompt set — which per-model family of meeting prompt templates renders.
# Default (UNSET): qwen3_5_9b, the frozen reference set — the default so its
# rendered bytes and its recorded prompt_versions stamp
# (orchestrator/game.py::DEFAULT_PROMPT_VERSIONS) never move. The operational
# baseline is qwen3_6_27b — the bespoke set for the canonical Featherless
# model, and the set the committed sample sets were recorded with (each set's
# MANIFEST.md names the recorded prompt_versions, e.g.
# accusation_round.qwen3_6_27b.v3). Export it to run that family.
# The registered names are enumerable from `PROMPT_VERSION_SETS` in
# orchestrator/game.py (a name with no entry there, or with no template
# directory under agents/strategic/prompts/, fails loud — no silent fallback).
# Under a REAL provider, an unset value prints a one-line stderr notice naming
# this variable: that is the expected reminder that the default family is not
# the baseline one, not a misconfiguration. The fake provider is silent — it
# runs no model, so nothing there can be a model generation behind anything.
# AILIBI_PROMPT_SET=qwen3_6_27b

# Model ids per call kind (shared across providers). Leave UNSET to use the
# active provider's defaults:
#   anthropic   → claude-sonnet-4-6 (meeting) / claude-haiku-4-5-20251001 (trigger)
#   ollama      → qwen3.5:9b (both)
#   featherless → Qwen/Qwen3.6-27B (both; the canonical production model,
#                 locked 2026-07-12 at Task 16.2 — audits/audit-phase-16-model-lock.md)
# Set them to override — e.g. an Ollama A/B swap qwen3.5:9b → llama3.1:8b.
# AILIBI_LLM_MEETING_MODEL=qwen3.5:9b
# AILIBI_LLM_TRIGGER_MODEL=qwen3.5:9b

# Anthropic API credentials. REQUIRED when AILIBI_LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Ollama (local) settings. Used only when AILIBI_LLM_PROVIDER=ollama.
# AILIBI_OLLAMA_HOST is the local server address (default localhost:11434).
# AILIBI_OLLAMA_SEED is an optional per-game seed (base-10 int; default 0)
# folded into generation for reproducible-ish FRESH output. Byte-identical
# determinism comes from the replay-record path, not the seed.
# AILIBI_OLLAMA_NUM_CTX is the context window (base-10 int > 0; default 8192).
# Ollama's own default bounds prompt + output together and silently truncates
# the largest meeting prompts; 8192 clears the measured max with headroom and
# costs nothing on shorter calls (llm/ollama_client.py DEFAULT_OLLAMA_NUM_CTX).
# AILIBI_OLLAMA_HOST=localhost:11434
# AILIBI_OLLAMA_SEED=0
# AILIBI_OLLAMA_NUM_CTX=8192

# Featherless (hosted) settings. Used only when AILIBI_LLM_PROVIDER=featherless.
# FEATHERLESS_API_KEY is REQUIRED in that mode (the client fails loud without
# it). AILIBI_FEATHERLESS_BASE_URL overrides the OpenAI-compatible base URL
# (default https://api.featherless.ai/v1; /chat/completions is appended) — set
# it only for a proxy or a self-hosted OpenAI-compatible endpoint. Cost is
# recorded as $0 (flat-rate subscription); the turn/vote token caps are the
# real backstop. Hosted FRESH generation is non-deterministic; recordings still
# replay byte-identically (the loosened contract Ollama already carries).
FEATHERLESS_API_KEY=
# AILIBI_FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# -----------------------------------------------------------------------------
# Belief-substrate levers
# -----------------------------------------------------------------------------
# GRADUATED LEVERS — always ON, nothing to set. Twenty-one belief/meeting levers
# have graduated: a baseline record adopted each one, the behavior became
# unconditional in code, and the AILIBI_* env gate was DELETED. In registry
# order (orchestrator/replay.py `_RETIRED_ALWAYS_ON_LEVERS` is the source of
# truth, exported as SUBSTRATE_FLAG_KEYS minus TOGGLEABLE_SUBSTRATE_FLAG_KEYS):
#
#   testimony_as_content, witnessed_kill_evidence, movement_perception,
#   unfreeze_memory, evidence_quality_lift, reporter_exculpation,
#   hard_evidence_gate, observation_id_rendering, citation_gate, absence_prior,
#   roll_call_round, whereabouts_interior_flags, vent_placement_contradictions,
#   task_completion_from_events, self_location_trail, movement_claim_shape,
#   grounded_prosecution, map_aware_arbitration, structured_turn_markers,
#   meeting_outcome_memory, coalesced_memory_render
#
# The adopting records, in order: the four Phase-13.5 levers merged at Task
# 14.9; evidence_quality_lift at the Task-14.12 baseline-2 re-record;
# reporter_exculpation at the Task-15.7 baseline-3 record; hard_evidence_gate,
# observation_id_rendering, and citation_gate at the Task-16.17 baseline-5
# record (audits/audit-phase-16-close.md §0.1); absence_prior, roll_call_round,
# whereabouts_interior_flags, and vent_placement_contradictions at the
# Task-18.12 baseline-6 record on the CREW-ONLY ruling
# (audits/audit-phase-18-baseline-6.md §0.1); and the last eight — the
# evidence-honesty slate — at the baseline-7 record, adopted by owner override of
# a FINDING verdict (audits/audit-phase-20-baseline-7.md §6.1) — the ladder tip.
#
# There is no variable to export for any of them: the OFF derivation no longer
# exists in this build, so an env var named after a graduated lever does
# nothing. They stay in the substrate stamp (the replay `game_over` record) and
# the MANIFEST `flags` cell purely as provenance, so a recording keeps
# self-describing the substrate that produced it and the loader can still refuse
# a legacy stamp this build cannot reproduce.

# The impostor-answer template arm, DEFAULT OFF. The five live substrate
# variables are listed below; the levers listed above have graduated.
# When ON, the impostor opening and reply templates ANSWER the Task-18.8
# whereabouts roll call with a structured self-placement (which the two-tier
# design lets be a lie) instead of the default hard-coded `"observations": []`;
# the crew path and the OFF path render byte-identically to the committed
# registry. Accepts 1/true/yes/on (case-insensitive); anything else — including
# unset — is OFF.
#
# DEFAULT OFF because the CREW-ONLY ruling
# (audits/audit-phase-18-meeting-gate.md §9) shipped the other four Phase-18
# meeting-layer levers and did NOT ship this arm — the probed impostor win
# missed the bright line the gate had set and the self-flag clause decided
# against it. Recordings stamp
# its state into the replay `game_over` record + the MANIFEST `flags` cell, and
# the loader refuses a cross-substrate reconstruction, so do NOT flip it for a
# serving / verify run against baseline 7: the committed sets were recorded from
# a bare environment (stamped False, hence absent from every MANIFEST `flags`
# list), and scripts/verify_samples.sh only reconstructs clean with it OFF. A
# future gate that ships the arm graduates it into the retired set the way the
# four meeting-layer levers graduated at 18.12.
# AILIBI_IMPOSTOR_ROLL_CALL=0

# The reporter-voice arm, DEFAULT OFF. Every body-report ballot already tells
# the table that reporting a
# body is weakly exculpatory; no turn prompt did, so the reporter spent their one
# turn before anyone could say it and was ejected far more often than any other
# innocent seat. When ON, three things change in what a speaker READS: every
# non-reporter turn prompt of a body-report meeting names the reporter and
# carries the ballot's own base-rate sentence, the reporter's opening is asked to
# state the discovery account plainly, and a speaker whose own record places them
# at the body is told so — in one neutral self-addressed line that names no other
# player. Nothing else moves: no flag is minted or re-banded, no threshold
# shifts, and the reporter stays as ejectable as before. Accepts 1/true/yes/on
# (case-insensitive); anything else — including unset — is OFF.
#
# DEFAULT OFF because it changes rendered prompt bytes, which is lever-gated
# until an adopting record (AGENTS.md craft rule 7). Recordings stamp its state
# into the replay `game_over` record + the MANIFEST `flags` cell, and a lever-ON
# run serves its own prompt-version strings, so do NOT flip it for a serving or
# verify run against the committed sets: those were recorded from a bare
# environment (the key predates them entirely, and a missing key reads OFF), and
# scripts/verify_samples.sh only reconstructs clean with it OFF.
# AILIBI_REPORTER_REASONING=0

# The source-count arm, DEFAULT OFF. A meeting knows two different things
# about a name: how many voices
# carry it, and how many of those voices actually saw something. The ballot
# renders only the first, so a charge one player invented and three repeated
# reads exactly like four independent accounts. When ON, the vote ballot gains
# one block per accused candidate stating how many voices carry the charge, how
# many of them described seeing the accused with their own record bearing it out,
# which turn it started in, whether that turn answered a charge the accused had
# just made, and any pair of spoken rooms the map says one tick of walking
# reconciles. Nothing is suppressed or re-scored: the tally, every flag and every
# threshold are untouched, and the closing line restates the confidence ladder
# the turn templates already ask for. Accepts 1/true/yes/on (case-insensitive);
# anything else — including unset — is OFF.
#
# DEFAULT OFF because it changes rendered prompt bytes, which is lever-gated
# until an adopting record (AGENTS.md craft rule 7). Recordings stamp its state
# into the replay `game_over` record + the MANIFEST `flags` cell, and a lever-ON
# run serves its own `vote_ballot` prompt-version string, so do NOT flip it for a
# serving or verify run against the committed sets: those were recorded from a
# bare environment (the key predates them entirely, and a missing key reads OFF),
# and scripts/verify_samples.sh only reconstructs clean with it OFF.
# AILIBI_CORROBORATION_DISCIPLINE=0

# The testimony-shapes arm, DEFAULT OFF. A meeting asks every player where
# they were and offers the
# witnessed-transition shape, and both arrive — then the reduction that turns a
# meeting into what listeners REMEMBER drops them whole, so the channel the
# prompts ask for hardest is the one memory keeps least. The witnessed KILL has
# it worse: there is no shape for it at all, so the strongest testimony the game
# produces can only reach the table as free text, which the reduction discards.
# When ON, two things change. Listeners keep three more spoken shapes as
# content — a roll-call self-placement (which also feeds the same
# stated-whereabouts map a spoken alibi feeds), a witnessed transition (the
# arrival room only), and a witnessed kill — and the crew turn prompts offer the
# witnessed-kill shape, naming the killer rather than the victim. A kill spoken
# that way is then rendered to every later speaker AND on the vote ballot, so
# the voter reads the shape the speakers were offered. Nothing is scored
# differently: no flag is minted or re-banded, no threshold moves, and a spoken
# kill stands exactly where a spoken vent stands before it is grounded — it is
# never counted as a first-hand source on the ballot's own source-count rows,
# because there is no record channel behind it to ground it against.
# Accepts 1/true/yes/on (case-insensitive); anything else — including unset — is
# OFF.
#
# DEFAULT OFF because it changes both rendered prompt bytes and recorded
# episodic memory, which is lever-gated until an adopting record (AGENTS.md
# craft rule 7). Recordings stamp its state into the replay `game_over` record +
# the MANIFEST `flags` cell, and a lever-ON run serves its own `crewmate_report`
# / `accusation_round` / `vote_ballot` prompt-version strings, so do NOT flip it
# for a serving or verify run against the committed sets: those were recorded
# from a bare environment (the key predates them entirely, and a missing key
# reads OFF), and scripts/verify_samples.sh only reconstructs clean with it OFF.
# The stamp is also what stops a load-time RE-DERIVATION running the arm over
# OFF-recorded bytes — the replay loader refuses the mismatch rather than
# rebuilding a memory the game never held.
# AILIBI_TESTIMONY_SHAPES=0

# Source-time observations, DEFAULT OFF. When ON, movement is witnessed at the
# actual sequential engine action, and entitled kill/vent/move events reach
# memory at their source tick before a same-tick meeting. Each event is delivered
# once; ordinary snapshots retain current-state information. This changes meeting
# evidence and needs an adopting record before becoming the default.
# Tick rows stamp the selected version even if the game later aborts. Version 1
# keeps the earlier experiment; 2 adds explicit snapshot/event timing, ordered
# observations and private task-attempt receipts. Old records missing the field
# remain OFF. Accepts 1/true/yes/on (case-insensitive), or explicit 2. Supported
# versioned readers select the recorded clock without an ambient timing override.
# AILIBI_TEMPORAL_OBSERVATIONS=0

# -----------------------------------------------------------------------------
# Independently versioned experiments
# -----------------------------------------------------------------------------
# Independent reasoning experiments, DEFAULT OFF. The enabled version is carried
# in each tick and terminal experiment_config, including interrupted games.
# These profiles do not add keys to the existing substrate_flags registry.
# They change meeting evidence or reply opportunities and require an adopting
# decision before becoming defaults. Evidence version 2 requires temporal version
# 2. Other profiles accept 1/true/yes/on (case-insensitive); omitted means OFF.
# AILIBI_EVIDENCE_REASONING=0
# AILIBI_BOUNDED_REBUTTAL=0
# Public accounts and attributed testimony are independent, require the
# qwen3_6_27b prompt family and cannot overlap the older meeting prompt toggles.
# Public accounts additionally require temporal version 2. Neither profile
# certifies another speaker's private records as shared truth.
# AILIBI_PUBLIC_ACCOUNTS=0
# AILIBI_ATTRIBUTED_TESTIMONY=0
# Tactical and structural comparisons use explicit RecordedExperimentConfig
# fields through experiments.tactical_gameplay; they have no ambient env switches.

# -----------------------------------------------------------------------------
# API server (spectator API)
# -----------------------------------------------------------------------------
# AILIBI_API_PORT is consumed only by docker-compose.yml (the published host
# port); it is not read by the application itself.
AILIBI_API_PORT=8000

# Directory the spectator API scans for replay JSONL files
# (``replay-seed-*.jsonl``), read once at app startup by api.main. Leave this
# UNSET to serve the committed curated set: the loader falls through
# ./replays -> ./replays/samples, and scripts/run_spectator.sh pins
# ./replays/samples explicitly. Set it ONLY to point the spectator at an ad-hoc
# local run dir (e.g. a scratch tournament written to ./replays). NOTE: an
# explicit value is honored as-is with NO fallthrough, so it must contain
# replay-seed-*.jsonl files or the loader fails loud.
# AILIBI_REPLAY_DIR=./replays/samples

# Cross-origin allowlist for the spectator API (comma-separated origins).
# Unset (default) = NO cross-origin access: the app installs no permissive CORS
# middleware (same-origin static serving and the Vite dev proxy need none). Set
# this ONLY for a deliberate cross-origin deployment, to an explicit closed list
# (never "*"). See docs/deployment.md.
# AILIBI_CORS_ORIGINS=https://spectator.example.com
